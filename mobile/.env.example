# ==============================================================================
# CallShadow Mobile App Configuration (.env)
# ==============================================================================

# Explicit Backend Base URL override
# When empty, the app auto-discovers the host from Expo Metro / LAN.
# Android Emulator: http://10.0.2.2:8000
# Physical Device over Wi-Fi: http://<YOUR_PC_LAN_IP>:8000 (e.g., http://192.168.1.5:8000)
# Web / iOS Simulator: http://localhost:8000

EXPO_PUBLIC_API_URL=http://localhost:8000
