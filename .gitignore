# ==============================================================================
# CallShadow Master Monorepo .gitignore
# ==============================================================================

# --- Operating System & Editor Metadata ---
.DS_Store
Thumbs.db
ehthumbs.db
.vscode/
.idea/
*.swp
*.swo

# --- Secrets & Environment Configurations ---
**/.env
**/.env.local
**/.env.*.local
secrets.json

# --- Python, Caching & Virtual Environments ---
**/__pycache__/
**/*.py[cod]
**/*.pyc
venv/
.venv/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# --- Databases & Runtime Test Artifacts ---
*.db
*.sqlite
*.sqlite3
test_pdf_*.pdf
test_audit_report.pdf

# --- Heavy ML Model Weights & Datasets (>100MB Git Limit) ---
# Models can be downloaded using download scripts or from Hugging Face / Releases
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.h5
*.bin
*.zip
*.tar.gz
*.rar
backend/data/LA/
backend/data/*.tar

# --- Node, Web & Mobile Build Outputs ---
**/node_modules/
**/dist/
**/build/
mobile/.expo/
mobile/.expo-shared/
mobile/android/app/build/
mobile/ios/build/
*.log
npm-debug.log*
yarn-debug.log*

