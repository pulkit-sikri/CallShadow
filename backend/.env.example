# ==============================================================================
# CallShadow Backend Configuration (.env)
# ==============================================================================

# Application Settings
APP_NAME= CallShadow AI Voice Deepfake Detector
APP_VERSION=1.0.0
DEBUG=False

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Database Connection
DATABASE_URL=sqlite:///./voice_detector.db

# Model Paths & Baseline
MODEL_DIR=./trained_model
BASE_MODEL_NAME=facebook/wav2vec2-base

# Audio Pipeline Thresholds
TARGET_SAMPLE_RATE=16000
CHUNK_DURATION=3.0
CHUNK_OVERLAP=1.0
AI_THRESHOLD=0.5
SPEAKER_MATCH_THRESHOLD=0.75
